        <rows>[federated.fy26permits0001].[none:PermitCategory:nk]</rows>
        <cols>([federated.fy26permits0001].[usr:Calc_AvgApprove:qk] + [federated.fy26permits0001].[usr:Calc_AvgIssue:qk])</cols>
      </table>
    </worksheet>
    <worksheet name="By Ward">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontsize="12">Average business days to approve, by ward (little variation)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="FY26 Permits" name="federated.fy26permits0001" />
          </datasources>
          <datasource-dependencies datasource="federated.fy26permits0001">
            <column datatype="date" name="[ApplicationDate]" role="dimension" type="ordinal" />
            <column datatype="date" name="[ApprovalDate]" role="dimension" type="ordinal" />
            <column datatype="date" name="[IssueDate]" role="dimension" type="ordinal" />
            <column datatype="string" name="[NewOrRenewal]" role="dimension" type="nominal" />
            <column datatype="string" name="[TrackingNumber]" role="dimension" type="nominal" />
            <column datatype="string" name="[Ward]" role="dimension" type="nominal" />
            <column caption="Avg Business Days to Approve" datatype="real" name="[Calc_AvgApprove]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0">
              <calculation class="tableau" formula="AVG([Calc_BDApprove])" />
            </column>
            <column caption="Avg Business Days to Issue" datatype="real" name="[Calc_AvgIssue]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0">
              <calculation class="tableau" formula="AVG([Calc_BDIssue])" />
            </column>
            <column caption="Business Days to Approve" datatype="integer" name="[Calc_BDApprove]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [Calc_InScope] THEN&#10;[Calc_WkApr] - [Calc_WkApp] - [Calc_HolApr]&#10;END" />
            </column>
            <column caption="Business Days to Issue" datatype="integer" name="[Calc_BDIssue]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [Calc_InScope] AND NOT ISNULL([ApprovalDate]) THEN&#10;[Calc_WkIss] - [Calc_WkApp] - [Calc_HolIss]&#10;END" />
            </column>
            <column caption="Diff vs Overall" datatype="real" name="[Calc_Diff]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0">
              <calculation class="tableau" formula="[Calc_AvgApprove] - AVG([Calc_Overall])" />
            </column>
            <column caption="Holidays - Application to Approval" datatype="integer" name="[Calc_HolApr]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IIF(#2025-10-13# &gt; [ApplicationDate] AND #2025-10-13# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2025-11-11# &gt; [ApplicationDate] AND #2025-11-11# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2025-11-27# &gt; [ApplicationDate] AND #2025-11-27# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2025-12-25# &gt; [ApplicationDate] AND #2025-12-25# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-01-01# &gt; [ApplicationDate] AND #2026-01-01# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-01-19# &gt; [ApplicationDate] AND #2026-01-19# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-02-16# &gt; [ApplicationDate] AND #2026-02-16# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-04-16# &gt; [ApplicationDate] AND #2026-04-16# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-05-25# &gt; [ApplicationDate] AND #2026-05-25# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-06-19# &gt; [ApplicationDate] AND #2026-06-19# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-07-03# &gt; [ApplicationDate] AND #2026-07-03# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-09-07# &gt; [ApplicationDate] AND #2026-09-07# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-10-12# &gt; [ApplicationDate] AND #2026-10-12# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-11-11# &gt; [ApplicationDate] AND #2026-11-11# &lt;= [ApprovalDate], 1, 0)" />
            </column>
            <column caption="Holidays - Application to Issue" datatype="integer" name="[Calc_HolIss]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IIF(#2025-10-13# &gt; [ApplicationDate] AND #2025-10-13# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2025-11-11# &gt; [ApplicationDate] AND #2025-11-11# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2025-11-27# &gt; [ApplicationDate] AND #2025-11-27# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2025-12-25# &gt; [ApplicationDate] AND #2025-12-25# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2026-01-01# &gt; [ApplicationDate] AND #2026-01-01# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2026-01-19# &gt; [ApplicationDate] AND #2026-01-19# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2026-02-16# &gt; [ApplicationDate] AND #2026-02-16# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2026-04-16# &gt; [ApplicationDate] AND #2026-04-16# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2026-05-25# &gt; [ApplicationDate] AND #2026-05-25# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2026-06-19# &gt; [ApplicationDate] AND #2026-06-19# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2026-07-03# &gt; [ApplicationDate] AND #2026-07-03# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2026-09-07# &gt; [ApplicationDate] AND #2026-09-07# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2026-10-12# &gt; [ApplicationDate] AND #2026-10-12# &lt;= [IssueDate], 1, 0) +&#10;IIF(#2026-11-11# &gt; [ApplicationDate] AND #2026-11-11# &lt;= [IssueDate], 1, 0)" />
            </column>
            <column caption="In Scope (FY26 New Issued)" datatype="boolean" name="[Calc_InScope]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[NewOrRenewal] = &quot;New&quot;&#10;AND [ApplicationDate] &gt;= #2025-10-01#&#10;AND [IssueDate] &gt;= #2025-10-01#&#10;AND [IssueDate] &lt;= #2026-09-30#" />
            </column>
            <column caption="Median Business Days to Approve" datatype="real" name="[Calc_MedApprove]" role="measure" type="quantitative" default-format="n#,##0;-#,##0">
              <calculation class="tableau" formula="MEDIAN([Calc_BDApprove])" />
            </column>
            <column caption="Overall Avg (FIXED)" datatype="real" name="[Calc_Overall]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0">
              <calculation class="tableau" formula="{ FIXED : AVG([Calc_BDApprove]) }" />
            </column>
            <column caption="Permits (measured)" datatype="integer" name="[Calc_Permits]" role="measure" type="quantitative" default-format="n#,##0;-#,##0">
              <calculation class="tableau" formula="COUNTD(IF NOT ISNULL([Calc_BDApprove]) THEN [TrackingNumber] END)" />
            </column>
            <column caption="Weekday Index - Application" datatype="integer" name="[Calc_WkApp]" role="measure" type="quantitative">
              <calculation class="tableau" formula="5 * INT(DATEDIFF('day', #2023-01-01#, [ApplicationDate]) / 7) + MIN(DATEDIFF('day', #2023-01-01#, [ApplicationDate]) % 7, 5)" />
            </column>
            <column caption="Weekday Index - Approval" datatype="integer" name="[Calc_WkApr]" role="measure" type="quantitative">
              <calculation class="tableau" formula="5 * INT(DATEDIFF('day', #2023-01-01#, [ApprovalDate]) / 7) + MIN(DATEDIFF('day', #2023-01-01#, [ApprovalDate]) % 7, 5)" />
            </column>
            <column caption="Weekday Index - Issue" datatype="integer" name="[Calc_WkIss]" role="measure" type="quantitative">
              <calculation class="tableau" formula="5 * INT(DATEDIFF('day', #2023-01-01#, [IssueDate]) / 7) + MIN(DATEDIFF('day', #2023-01-01#, [IssueDate]) % 7, 5)" />
            </column>
            <column-instance column="[Calc_AvgApprove]" derivation="User" name="[usr:Calc_AvgApprove:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Ward]" derivation="None" name="[none:Ward:nk]" pivot="key" type="nominal" />
            <column-instance column="[Calc_Permits]" derivation="User" name="[usr:Calc_Permits:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_MedApprove]" derivation="User" name="[usr:Calc_MedApprove:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_AvgIssue]" derivation="User" name="[usr:Calc_AvgIssue:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_Diff]" derivation="User" name="[usr:Calc_Diff:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_InScope]" derivation="None" name="[none:Calc_InScope:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.fy26permits0001].[none:Calc_InScope:nk]">
            <groupfilter function="member" level="[none:Calc_InScope:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <slices>
            <column>[federated.fy26permits0001].[none:Calc_InScope:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <text column="[federated.fy26permits0001].[usr:Calc_AvgApprove:qk]" />
              <text column="[federated.fy26permits0001].[usr:Calc_Permits:qk]" />
              <tooltip column="[federated.fy26permits0001].[usr:Calc_MedApprove:qk]" />
              <tooltip column="[federated.fy26permits0001].[usr:Calc_AvgIssue:qk]" />
              <tooltip column="[federated.fy26permits0001].[usr:Calc_Diff:qk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run>&lt;[federated.fy26permits0001].[usr:Calc_AvgApprove:qk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.fy26permits0001].[usr:Calc_AvgApprove:qk]</rows>
        <cols>[federated.fy26permits0001].[none:Ward:nk]</cols>
      </table>
    </worksheet>
    <worksheet name="Monthly Trend (censored)">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontsize="12">By application month</run>
            <run>Æ
</run>
            <run fontsize="9" fontcolor="#c00000">CAUTION: late-FY months only include permits issued by 9/30/2026, so they are biased toward fast approvals.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="FY26 Permits" name="federated.fy26permits0001" />
          </datasources>
          <datasource-dependencies datasource="federated.fy26permits0001">
            <column datatype="date" name="[ApplicationDate]" role="dimension" type="ordinal" />
            <column datatype="date" name="[ApprovalDate]" role="dimension" type="ordinal" />
            <column datatype="date" name="[IssueDate]" role="dimension" type="ordinal" />
            <column datatype="string" name="[NewOrRenewal]" role="dimension" type="nominal" />
            <column datatype="string" name="[TrackingNumber]" role="dimension" type="nominal" />
            <column caption="Avg Business Days to Approve" datatype="real" name="[Calc_AvgApprove]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0">
              <calculation class="tableau" formula="AVG([Calc_BDApprove])" />
            </column>
            <column caption="Business Days to Approve" datatype="integer" name="[Calc_BDApprove]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [Calc_InScope] THEN&#10;[Calc_WkApr] - [Calc_WkApp] - [Calc_HolApr]&#10;END" />
            </column>
            <column caption="Holidays - Application to Approval" datatype="integer" name="[Calc_HolApr]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IIF(#2025-10-13# &gt; [ApplicationDate] AND #2025-10-13# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2025-11-11# &gt; [ApplicationDate] AND #2025-11-11# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2025-11-27# &gt; [ApplicationDate] AND #2025-11-27# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2025-12-25# &gt; [ApplicationDate] AND #2025-12-25# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-01-01# &gt; [ApplicationDate] AND #2026-01-01# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-01-19# &gt; [ApplicationDate] AND #2026-01-19# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-02-16# &gt; [ApplicationDate] AND #2026-02-16# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-04-16# &gt; [ApplicationDate] AND #2026-04-16# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-05-25# &gt; [ApplicationDate] AND #2026-05-25# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-06-19# &gt; [ApplicationDate] AND #2026-06-19# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-07-03# &gt; [ApplicationDate] AND #2026-07-03# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-09-07# &gt; [ApplicationDate] AND #2026-09-07# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-10-12# &gt; [ApplicationDate] AND #2026-10-12# &lt;= [ApprovalDate], 1, 0) +&#10;IIF(#2026-11-11# &gt; [ApplicationDate] AND #2026-11-11# &lt;= [ApprovalDate], 1, 0)" />
            </column>
            <column caption="In Scope (FY26 New Issued)" datatype="boolean" name="[Calc_InScope]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[NewOrRenewal] = &quot;New&quot;&#10;AND [ApplicationDate] &gt;= #2025-10-01#&#10;AND [IssueDate] &gt;= #2025-10-01#&#10;AND [IssueDate] &lt;= #2026-09-30#" />
            </column>
            <column caption="Permits (measured)" datatype="integer" name="[Calc_Permits]" role="measure" type="quantitative" default-format="n#,##0;-#,##0">
              <calculation class="tableau" formula="COUNTD(IF NOT ISNULL([Calc_BDApprove]) THEN [TrackingNumber] END)" />
            </column>
            <column caption="Weekday Index - Application" datatype="integer" name="[Calc_WkApp]" role="measure" type="quantitative">
              <calculation class="tableau" formula="5 * INT(DATEDIFF('day', #2023-01-01#, [ApplicationDate]) / 7) + MIN(DATEDIFF('day', #2023-01-01#, [ApplicationDate]) % 7, 5)" />
            </column>
            <column caption="Weekday Index - Approval" datatype="integer" name="[Calc_WkApr]" role="measure" type="quantitative">
              <calculation class="tableau" formula="5 * INT(DATEDIFF('day', #2023-01-01#, [ApprovalDate]) / 7) + MIN(DATEDIFF('day', #2023-01-01#, [ApprovalDate]) % 7, 5)" />
            </column>
            <column-instance column="[Calc_AvgApprove]" derivation="User" name="[usr:Calc_AvgApprove:qk]" pivot="key" type="quantitative" />
            <column-instance column="[ApplicationDate]" derivation="Month-Trunc" name="[tmn:ApplicationDate:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_Permits]" derivation="User" name="[usr:Calc_Permits:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_InScope]" derivation="None" name="[none:Calc_InScope:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.fy26permits0001].[none:Calc_InScope:nk]">
            <groupfilter function="member" level="[none:Calc_InScope:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <slices>
            <column>[federated.fy26permits0001].[none:Calc_InScope:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <text column="[federated.fy26permits0001].[usr:Calc_AvgApprove:qk]" />
              <tooltip column="[federated.fy26permits0001].[usr:Calc_Permits:qk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run>&lt;[federated.fy26permits0001].[usr:Calc_AvgApprove:qk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.fy26permits0001].[usr:Calc_AvgApprove:qk]</rows>
        <cols>[federated.fy26permits0001].[tmn:ApplicationDate:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="FY26 Permit Approval Times">
      <style />
      <size maxheight="1000" maxwidth="1400" minheight="1000" minwidth="1400" sizing-mode="fixed" />
      <zones>
        <zone h="100000" id="1" type-v2="layout-basic" w="100000" x="0" y="0">
          <zone h="100000" id="2" param="vert" type-v2="layout-flow" w="100000" x="0" y="0">
            <zone h="5000" id="3" type-v2="text" w="100000" x="0" y="0">
              <formatted-text>
                <run bold="true" fontsize="20" fontcolor="#1f3864">FY2026 Public Space Construction Permits: Business Days to Approve</run>
              </formatted-text>
            </zone>
            <zone h="5000" id="4" type-v2="text" w="100000" x="0" y="5000">
              <formatted-text>
                <run fontsize="10" fontcolor="#404040">New permits applied for on or after Oct 1, 2025 and issued in FY26 (Oct 1, 2025 - Sep 30, 2026). Business days count from application to DDOT's final approval and exclude weekends and DC holidays. Source: DDOT TOPS, deduplicated to one row per permit. Click a permit category to filter the whole dashboard; click again to clear.</run>
              </formatted-text>
            </zone>
            <zone h="40000" id="5" param="horz" type-v2="layout-flow" w="100000" x="0" y="10000">
              <zone h="40000" id="6" param="vert" type-v2="layout-flow" w="32000" x="0" y="10000">
                <zone h="4000" id="7" type-v2="text" w="32000" x="0" y="10000">
                  <formatted-text>
                    <run bold="true" fontsize="12" fontcolor="#1f3864">1 | Overall performance</run>
                  </formatted-text>
                  <zone-style>
                    <format attr="background-color" value="#dce6f2" />
                  </zone-style>
                </zone>
                <zone h="21000" id="8" name="KPI - Overall" show-title="false" w="32000" x="0" y="14000" />
                <zone h="15000" id="9" name="Distribution" w="32000" x="0" y="35000" />
              </zone>
              <zone h="40000" id="10" param="vert" type-v2="layout-flow" w="68000" x="32000" y="10000">
                <zone h="4000" id="11" type-v2="text" w="68000" x="32000" y="10000">
                  <formatted-text>
                    <run bold="true" fontsize="12" fontcolor="#1f3864">2 | By permit type category</run>
                    <run fontsize="9" fontcolor="#595959">   Click a bar to filter the dashboard; line = overall average; Excavation is split by utility because it is 90% of permits</run>
                  </formatted-text>
                  <zone-style>
                    <format attr="background-color" value="#dce6f2" />
                  </zone-style>
                </zone>
                <zone h="36000" id="12" name="By Permit Category" w="68000" x="32000" y="14000" />
              </zone>
            </zone>
            <zone h="4000" id="13" type-v2="text" w="100000" x="0" y="50000">
              <formatted-text>
                <run bold="true" fontsize="12" fontcolor="#1f3864">3 | Where approval times differ</run>
                <run fontsize="9" fontcolor="#595959">   Resubmission and project size separate fast from slow; geography does not (see Data Segmentation tab)</run>
              </formatted-text>
              <zone-style>
                <format attr="background-color" value="#dce6f2" />
              </zone-style>
            </zone>
            <zone h="31000" id="14" param="horz" type-v2="layout-flow" w="100000" x="0" y="54000">
              <zone h="31000" id="15" name="By Applicant Type" w="34000" x="0" y="54000" />
              <zone h="31000" id="16" name="Resubmission Impact" w="33000" x="34000" y="54000" />
              <zone h="31000" id="17" name="Work Location Size" w="33000" x="67000" y="54000" />
            </zone>
            <zone h="15000" id="18" param="horz" type-v2="layout-flow" w="100000" x="0" y="85000">
              <zone h="15000" id="19" type-v2="text" w="62000" x="0" y="85000">
                <formatted-text>
                  <run bold="true" fontsize="12" fontcolor="#1f3864">Key takeaways</run>
                  <run>Æ
</run>
                  <run fontsize="10" fontcolor="#404040">- 22.2 avg / 13 median business days. The average blends a same-day group (22%) with a 60+ day tail (9%).</run>
                  <run>Æ
</run>
                  <run fontsize="10" fontcolor="#404040">- Widest gap is resubmission: 12.4 vs 48.3 days. 27% of permits account for 59% of approval days.</run>
                  <run>Æ
</run>
                  <run fontsize="10" fontcolor="#404040">- Project size: 1 block 13.5 days vs 6-20 blocks 51.7. DC Water single-block permits take 7 days, multi-block 41-52.</run>
                  <run>Æ
</run>
                  <run fontsize="10" fontcolor="#404040">- Category: Sewer/Storm 0.9 and Gas 8.0, up to Water 35.7 and Multiple Work Types 51.0. Water is 32% of permits and 51% of approval days.</run>
                  <run>Æ
</run>
                  <run fontsize="10" fontcolor="#404040">- Applicant: Washington Gas 8.9, DC Water 31.2, Private 44.1. Private applicants are asked to resubmit 68% of the time.</run>
                </formatted-text>
                <zone-style>
                  <format attr="background-color" value="#f2f2f2" />
                </zone-style>
              </zone>
              <zone h="15000" id="20" type-v2="text" w="38000" x="62000" y="85000">
                <formatted-text>
                  <run bold="true" fontsize="12" fontcolor="#1f3864">Next steps</run>
                  <run>Æ
</run>
                  <run fontsize="10" fontcolor="#404040">1. Analyze reasons for Revise &amp; Resubmit requests by category.</run>
                  <run>Æ
</run>
                  <run fontsize="10" fontcolor="#404040">2. Review DC Water multi-block lateral work as a program.</run>
                  <run>Æ
</run>
                  <run fontsize="10" fontcolor="#404040">3. Split time into queue, review, and applicant-payment stages.</run>
                  <run>Æ
</run>
                  <run fontsize="10" fontcolor="#404040">4. Use cohort-based trends (the monthly view is cut off at year end).</run>
                  <run>Æ
</run>
                  <run fontsize="9" fontcolor="#595959">Holidays excluded: 10/13, 11/11, 11/27, 12/25, 1/1, 1/19, 2/16, 4/16, 5/25, 6/19, 7/3, 9/7</run>
                  <run>Æ
</run>
                  <run fontsize="9" fontcolor="#595959">5 of 2,992 in-scope permits have no approval date and are left out of the business-day averages (n = 2,987).</run>
                </formatted-text>
                <zone-style>
                  <format attr="background-color" value="#f2f2f2" />
                </zone-style>
              </zone>
            </zone>
          </zone>
        </zone>
      </zones>
    </dashboard>
    <dashboard name="Data Segmentation">
      <style />
      <size maxheight="1000" maxwidth="1400" minheight="1000" minwidth="1400" sizing-mode="fixed" />
      <zones>
        <zone h="100000" id="1" type-v2="layout-basic" w="100000" x="0" y="0">
          <zone h="100000" id="2" param="vert" type-v2="layout-flow" w="100000" x="0" y="0">
            <zone h="8000" id="3" type-v2="text" w="100000" x="0" y="0">
              <formatted-text>
                <run bold="true" fontsize="20" fontcolor="#1f3864">Data segmentation: what separates fast and slow approvals</run>
                <run>Æ
</run>
                <run fontsize="10" fontcolor="#404040">Cross-checks behind the main dashboard: is the gap real within each group, and where does time go after approval?</run>
              </formatted-text>
            </zone>
            <zone h="36000" id="4" param="horz" type-v2="layout-flow" w="100000" x="0" y="8000">
              <zone h="36000" id="5" name="Applicant x Resubmission" w="50000" x="0" y="8000" />
              <zone h="36000" id="6" name="Approval vs Issuance" w="50000" x="50000" y="8000" />
            </zone>
            <zone h="36000" id="7" param="horz" type-v2="layout-flow" w="100000" x="0" y="44000">
              <zone h="36000" id="8" name="By Ward" w="50000" x="0" y="44000" />
              <zone h="36000" id="9" name="Monthly Trend (censored)" w="50000" x="50000" y="44000" />
            </zone>
            <zone h="20000" id="10" type-v2="text" w="100000" x="0" y="80000">
              <formatted-text>
                <run bold="true" fontsize="12" fontcolor="#1f3864">Key takeaways</run>
                <run>Æ
</run>
                <run fontsize="10" fontcolor="#404040">- Resubmission gap holds for every applicant type: Washington Gas 5.5 vs 33.6 days, DC Water 19.6 vs 54.9, Private 20.3 vs 55.2. It is not an applicant-mix effect.</run>
                <run>Æ
</run>
                <run fontsize="10" fontcolor="#404040">- Most permits issue 3-5 business days after approval. Excavation - Gas is the exception: 8.0 days to approve but 55.3 to issue, and it holds 87% of all post-approval days.</run>
                <run>Æ
</run>
                <run fontsize="10" fontcolor="#404040">- The gas issuance wait is skewed (median 6 days, but 36% wait 20+), so it points to a payment or pickup step on a subset of permits, not to DDOT review.</run>
                <run>Æ
</run>
                <run fontsize="10" fontcolor="#404040">- Geography explains little: Wards 1-8 average 18.2 to 27.2 days with medians of 9 to 17. Only the 18 multi-ward permits stand out (36.8).</run>
                <run>Æ
</run>
                <run fontsize="10" fontcolor="#404040">- The monthly drop is not an improvement: Oct-May applications average 37.6 days vs 12.4 for Jun-Sep, because slow late-year permits were not yet issued by 9/30.</run>
                <run>Æ
</run>
                <run fontsize="10" fontcolor="#404040">- Where to act: Revise &amp; Resubmit requests and the gas approval-to-issuance gap, not ward-level or seasonal factors.</run>
              </formatted-text>
              <zone-style>
                <format attr="background-color" value="#f2f2f2" />
              </zone-style>
            </zone>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows source-height="30">
    <window class="worksheet" name="KPI - Overall">
      <cards>
        <edge name="left">
          <strip size="160">
            <card type="pages" />
            <card type="filters" />
            <card type="marks" />
          </strip>
        </edge>
        <edge name="top">
          <strip size="2147483647">
            <card type="columns" />
          </strip>
          <strip size="2147483647">
            <card type="rows" />
          </strip>
          <strip size="2147483647">
            <card type="title" />
          </strip>
        </edge>
