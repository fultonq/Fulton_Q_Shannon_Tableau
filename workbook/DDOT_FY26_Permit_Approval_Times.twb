      <column caption="% Over 60 Business Days" datatype='real' default-format="p0.0%" name="[Calc_PctOver60]" role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IIF([BusDaysToApprove] &gt; 60, 1, 0)) / COUNT([BusDaysToApprove])" /></column>
      <column caption="% of Permits" datatype='real' default-format="p0.0%" name="[Calc_PctOfPermits]" role='measure' type='quantitative'><calculation class='tableau' formula="COUNTD([OBJECTID]) / TOTAL(COUNTD([OBJECTID]))" /></column>
