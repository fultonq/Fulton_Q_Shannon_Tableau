  <worksheets>
    <worksheet name="1. Overall Avg Business Days">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontsize="12">FY26 overall: new permits issued in FY26</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="FY26 New Issued Permits" name="federated.0fy26permits0approval0times" />
          </datasources>
          <datasource-dependencies datasource="federated.0fy26permits0approval0times">
            <column caption="Business Days to Approve" datatype="integer" name="[BusDaysToApprove]" role="measure" type="quantitative" />
            <column datatype="integer" name="[OBJECTID]" role="dimension" type="ordinal" />
            <column datatype="integer" name="[SameDayApproval]" role="measure" type="quantitative" />
            <column caption="Business Days to Issue" datatype="integer" name="[BusDaysToIssue]" role="measure" type="quantitative" />
            <column caption="Avg Business Days to Approve" datatype='real' default-format="n#,##0.0" name="[Calc_AvgApprove]" role='measure' type='quantitative'><calculation class='tableau' formula="AVG([BusDaysToApprove])" /></column>
            <column caption="Median Business Days to Approve" datatype='real' default-format="n#,##0.0" name="[Calc_MedianApprove]" role='measure' type='quantitative'><calculation class='tableau' formula="MEDIAN([BusDaysToApprove])" /></column>
            <column caption="Permits" datatype='real' default-format="n#,##0" name="[Calc_Permits]" role='measure' type='quantitative'><calculation class='tableau' formula="COUNTD([OBJECTID])" /></column>
            <column caption="% Approved Same Day" datatype='real' default-format="p0.0%" name="[Calc_PctSameDay]" role='measure' type='quantitative'><calculation class='tableau' formula="AVG([SameDayApproval])" /></column>
            <column caption="% Over 60 Business Days" datatype='real' default-format="p0.0%" name="[Calc_PctOver60]" role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IIF([BusDaysToApprove] &gt; 60, 1, 0)) / COUNT([BusDaysToApprove])" /></column>
            <column caption="Avg Business Days to Issue" datatype='real' default-format="n#,##0.0" name="[Calc_AvgIssue]" role='measure' type='quantitative'><calculation class='tableau' formula="AVG([BusDaysToIssue])" /></column>
            <column-instance column="[Calc_AvgApprove]" derivation="User" name="[usr:Calc_AvgApprove:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_AvgIssue]" derivation="User" name="[usr:Calc_AvgIssue:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_MedianApprove]" derivation="User" name="[usr:Calc_MedianApprove:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_PctOver60]" derivation="User" name="[usr:Calc_PctOver60:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_PctSameDay]" derivation="User" name="[usr:Calc_PctSameDay:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_Permits]" derivation="User" name="[usr:Calc_Permits:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <filter class='categorical' column="[federated.0fy26permits0approval0times].[:Measure Names]">
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='"[federated.0fy26permits0approval0times].[usr:Calc_AvgApprove:qk]"' />
              <groupfilter function='member' level='[:Measure Names]' member='"[federated.0fy26permits0approval0times].[usr:Calc_MedianApprove:qk]"' />
              <groupfilter function='member' level='[:Measure Names]' member='"[federated.0fy26permits0approval0times].[usr:Calc_Permits:qk]"' />
              <groupfilter function='member' level='[:Measure Names]' member='"[federated.0fy26permits0approval0times].[usr:Calc_PctSameDay:qk]"' />
              <groupfilter function='member' level='[:Measure Names]' member='"[federated.0fy26permits0approval0times].[usr:Calc_PctOver60:qk]"' />
              <groupfilter function='member' level='[:Measure Names]' member='"[federated.0fy26permits0approval0times].[usr:Calc_AvgIssue:qk]"' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0fy26permits0approval0times].[:Measure Names]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='header'>
            <format attr='width' field="[federated.0fy26permits0approval0times].[:Measure Names]" value='300' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Text" />
              <encodings>
                <text column="[federated.0fy26permits0approval0times].[Multiple Values]" />
              </encodings>
          </pane>
        </panes>
        <rows>[federated.0fy26permits0approval0times].[:Measure Names]</rows>
        <cols />
      </table>
    </worksheet>
    <worksheet name="2. Avg Days by Permit Type">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontsize="12">Average business days to approve by permit type category</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="FY26 New Issued Permits" name="federated.0fy26permits0approval0times" />
          </datasources>
          <datasource-dependencies datasource="federated.0fy26permits0approval0times">
            <column caption="Permit Type Category" datatype="string" name="[WorkFocus]" role="dimension" type="nominal" />
            <column caption="Business Days to Approve" datatype="integer" name="[BusDaysToApprove]" role="measure" type="quantitative" />
            <column datatype="integer" name="[OBJECTID]" role="dimension" type="ordinal" />
            <column caption="Business Days to Issue" datatype="integer" name="[BusDaysToIssue]" role="measure" type="quantitative" />
            <column caption="Avg Business Days to Approve" datatype='real' default-format="n#,##0.0" name="[Calc_AvgApprove]" role='measure' type='quantitative'><calculation class='tableau' formula="AVG([BusDaysToApprove])" /></column>
            <column caption="Permits" datatype='real' default-format="n#,##0" name="[Calc_Permits]" role='measure' type='quantitative'><calculation class='tableau' formula="COUNTD([OBJECTID])" /></column>
            <column caption="Median Business Days to Approve" datatype='real' default-format="n#,##0.0" name="[Calc_MedianApprove]" role='measure' type='quantitative'><calculation class='tableau' formula="MEDIAN([BusDaysToApprove])" /></column>
            <column caption="Avg Business Days to Issue" datatype='real' default-format="n#,##0.0" name="[Calc_AvgIssue]" role='measure' type='quantitative'><calculation class='tableau' formula="AVG([BusDaysToIssue])" /></column>
            <column caption="% Over 60 Business Days" datatype='real' default-format="p0.0%" name="[Calc_PctOver60]" role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IIF([BusDaysToApprove] &gt; 60, 1, 0)) / COUNT([BusDaysToApprove])" /></column>
            <column-instance column="[WorkFocus]" derivation="None" name="[none:WorkFocus:nk]" pivot='key' type="nominal" />
            <column-instance column="[Calc_AvgApprove]" derivation="User" name="[usr:Calc_AvgApprove:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_AvgIssue]" derivation="User" name="[usr:Calc_AvgIssue:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_MedianApprove]" derivation="User" name="[usr:Calc_MedianApprove:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_PctOver60]" derivation="User" name="[usr:Calc_PctOver60:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_Permits]" derivation="User" name="[usr:Calc_Permits:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <sort class='computed' column="[federated.0fy26permits0approval0times].[none:WorkFocus:nk]" direction="DESC" using="[federated.0fy26permits0approval0times].[usr:Calc_AvgApprove:qk]" />
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='header'>
            <format attr='width' field="[federated.0fy26permits0approval0times].[none:WorkFocus:nk]" value='200' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
