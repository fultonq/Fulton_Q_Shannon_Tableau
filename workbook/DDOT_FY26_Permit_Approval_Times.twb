            <column-instance column="[SegmentLabel]" derivation="None" name="[none:SegmentLabel:nk]" pivot='key' type="nominal" />
            <column-instance column="[AvgBusDaysToApprove]" derivation="Sum" name="[sum:AvgBusDaysToApprove:qk]" pivot='key' type="quantitative" />
            <column-instance column="[DiffFromAverage]" derivation="Sum" name="[sum:DiffFromAverage:qk]" pivot='key' type="quantitative" />
            <column-instance column="[MedianBusDaysToApprove]" derivation="Sum" name="[sum:MedianBusDaysToApprove:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Permits]" derivation="Sum" name="[sum:Permits:qk]" pivot='key' type="quantitative" />
            <column-instance column="[ScopeAverage]" derivation="Sum" name="[sum:ScopeAverage:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <filter class='categorical' column="[federated.0segment0comparison0vs0average].[none:Scope:nk]">
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
