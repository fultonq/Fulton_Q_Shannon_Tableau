              <groupfilter function='member' level="[none:Flag:nk]" member='"Within 7 days of average"' />
            </groupfilter>
          </filter>
          <sort class='computed' column="[federated.0segment0comparison0vs0average].[none:SegmentLabel:nk]" direction="DESC" using="[federated.0segment0comparison0vs0average].[sum:DiffFromAverage:qk]" />
          <slices>
            <column>[federated.0segment0comparison0vs0average].[none:Scope:nk]</column>
