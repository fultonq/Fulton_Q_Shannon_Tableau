            <column caption="Permits" datatype='real' default-format="n#,##0" name="[Calc_Permits]" role='measure' type='quantitative'><calculation class='tableau' formula="COUNTD([OBJECTID])" /></column>
            <column caption="% of Permits" datatype='real' default-format="p0.0%" name="[Calc_PctOfPermits]" role='measure' type='quantitative'><calculation class='tableau' formula="COUNTD([OBJECTID]) / TOTAL(COUNTD([OBJECTID]))" /></column>
            <column caption="Avg Business Days to Approve" datatype='real' default-format="n#,##0.0" name="[Calc_AvgApprove]" role='measure' type='quantitative'><calculation class='tableau' formula="AVG([BusDaysToApprove])" /></column>
            <column-instance column="[BusDaysToApprove]" derivation="Min" name="[min:BusDaysToApprove:qk]" pivot='key' type="quantitative" />
            <column-instance column="[ApprovalBucket]" derivation="None" name="[none:ApprovalBucket:nk]" pivot='key' type="nominal" />
            <column-instance column="[Calc_AvgApprove]" derivation="User" name="[usr:Calc_AvgApprove:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_PctOfPermits]" derivation="User" name="[usr:Calc_PctOfPermits:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_Permits]" derivation="User" name="[usr:Calc_Permits:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <filter class='categorical' column="[federated.0fy26permits0approval0times].[none:ApprovalBucket:nk]">
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level="[none:ApprovalBucket:nk]" />
              <groupfilter function='member' level="[none:ApprovalBucket:nk]" member='"Not Approved"' />
            </groupfilter>
          </filter>
          <sort class='computed' column="[federated.0fy26permits0approval0times].[none:ApprovalBucket:nk]" direction="ASC" using="[federated.0fy26permits0approval0times].[min:BusDaysToApprove:qk]" />
