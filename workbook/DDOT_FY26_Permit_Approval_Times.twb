            <column default-format="n#,##0" datatype="integer" name="[Permits]" role="measure" type="quantitative" />
            <column caption="Segment Avg Business Days to Approve" default-format="n#,##0.0" datatype="real" name="[AvgBusDaysToApprove]" role="measure" type="quantitative" />
